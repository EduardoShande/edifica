# Copy this file to `.env.local` and fill in real values.

# Public site URL (used for canonical URLs, sitemap, robots, structured data).
# Set to your real domain in production, e.g. https://edifica.com.bo
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google Search Console verification code (the content="..." value of the
# HTML tag Google gives you). Lets Google confirm you own the site so it
# indexes faster. Leave empty until you register at search.google.com/search-console
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Automation webhook (n8n / Make / Zapier) that receives new leads.
# When set, each website lead is forwarded here so you can:
#   - store it in a database (Supabase)
#   - send an instant WhatsApp notification to Eduardo and Dad
# Leave empty during early testing — the site still works and logs leads.
LEAD_WEBHOOK_URL=
